# --- Neon (Postgres serverless) ---
# Panel de Neon → tu proyecto → Connection Details → connection string.
# Usá la "pooled connection" e incluí ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Better Auth (identidad + organizaciones) ---
# Secreto para firmar sesiones. Generá uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo
# URL base de la app (sin barra final).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Anthropic (generación documental) ---
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar (opcional). Por defecto: claude-opus-4-8
# Alternativa más económica: claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-4-8

# --- Vercel Blob (evidencias de formación + logo white-label) ---
# Panel de Vercel → Storage → Blob → crear store → copiar el token de lectura/escritura.
# En local: `vercel env pull` o pegá el token acá.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Stripe (suscripciones) ---
# https://dashboard.stripe.com/test/apikeys  (usá las claves de TEST en desarrollo)
STRIPE_SECRET_KEY=sk_test_...
# Secreto del webhook: lo da `stripe listen` o el panel al crear el endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de Price (test). Se crean en Stripe y se pegan acá (ver README).
NEXT_PUBLIC_STRIPE_PRICE_EMPRESA_S=price_...
NEXT_PUBLIC_STRIPE_PRICE_EMPRESA_M=price_...
NEXT_PUBLIC_STRIPE_PRICE_EMPRESA_L=price_...
NEXT_PUBLIC_STRIPE_PRICE_ASESORIA_10=price_...
NEXT_PUBLIC_STRIPE_PRICE_ASESORIA_25=price_...
